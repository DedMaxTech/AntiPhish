# CLI/Python load environment variables from the process; no implicit dotenv load.
ANTIPHISH_DATA_DIR=/data/antiphish
ANTIPHISH_MODEL_DIR=/data/antiphish/models
ANTIPHISH_API_HOST=127.0.0.1
ANTIPHISH_API_PORT=8000
# Optional browser override. Otherwise Edge on Windows, Playwright Chromium on Linux.
# ANTIPHISH_BROWSER_EXECUTABLE=/usr/bin/chromium
# Optional compatible local multimodal model, e.g. previously downloaded Gemma.
# ANTIPHISH_LLM_MODEL_DIR=/models/Qwen3.5-4B
# Optional experimental scores, no effect on the verdict:
# ANTIPHISH_TEXT_MODEL_DIR=/models/phishing-scam-detector-base
